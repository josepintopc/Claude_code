<UserControl x:Class="SupernovaBench.App.Views.DiskHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,0,12">
            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr health.refresh}" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="{loc:Tr health.title}" />
                <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr health.subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- um chip por disco -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr common.loading}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr health.noDisks}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskHealthItem}">
                        <RadioButton Style="{StaticResource Chip}" GroupName="healthdisk" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,8,0" Fill="{DynamicResource Muted}" />
                                <TextBlock Text="{Binding ChipLabel}" />
                            </StackPanel>
                        </RadioButton>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGood}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Good}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsCaution}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warn}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsBad}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Bad}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- detalhes do disco selecionado -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding Selected}" Focusable="False">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:DiskHealthItem}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- selo de saúde -->
                                <Border x:Name="Badge" Style="{StaticResource CardPanel}" BorderThickness="2" BorderBrush="{DynamicResource Line}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr health.status}" />
                                        <TextBlock x:Name="StatusLabel" Margin="0,6,0,0" FontSize="34" FontWeight="Bold" Text="{Binding StatusText}" />
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding LifeText}"
                                                   Visibility="{Binding LifeText, Converter={StaticResource EmptyToVis}}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="{loc:Tr health.temperature}" />
                                        <TextBlock Style="{StaticResource BigNumber}" FontSize="40" Text="{Binding TemperatureText}" />
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Notes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                                                        <TextBlock Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="240" Text="{Binding}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- resumo -->
                                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Subtitle}" />
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Text="{Binding UnavailableText}"
                                                   Visibility="{Binding UnavailableText, Converter={StaticResource EmptyToVis}}" />
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Summary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HealthLine}">
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="240" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource Mono}" TextWrapping="Wrap" Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- atributos SMART (SATA) -->
                            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0" Visibility="{Binding HasAttributes, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr health.attributes}" />
                                    <Grid Margin="0,10,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Caption}" Text="ID" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{loc:Tr health.col.name}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{loc:Tr health.col.current}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{loc:Tr health.col.worst}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="{loc:Tr health.col.threshold}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource Caption}" Text="{loc:Tr health.col.raw}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Attributes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SmartRow}">
                                                <Border x:Name="AttrRow" Padding="0,4" CornerRadius="6" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="140" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Mono}" Text="{Binding Id}" />
                                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource Mono}" Text="{Binding Current}" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Mono}" Text="{Binding Worst}" />
                                                        <TextBlock Grid.Column="4" Style="{StaticResource Mono}" Text="{Binding Threshold}" />
                                                        <TextBlock Grid.Column="5" Style="{StaticResource Mono}" Text="{Binding Raw}" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Failing}" Value="True">
                                                        <Setter TargetName="AttrRow" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Text="{loc:Tr health.footer}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Good}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Good}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCaution}" Value="True">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Warn}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBad}" Value="True">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Bad}" />
                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource Bad}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
