<UserControl x:Class="SupernovaBench.App.Views.GpuStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,12">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr stress.title}" />
            <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr stress.subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Banner}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                <TextBlock Margin="10,0,0,0" Style="{StaticResource Body}" Text="{loc:Tr stress.warning}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ configuração e estado -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr gpu.adapter}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Text="{Binding AdapterName}" />

                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,8" Text="{loc:Tr gpu.resolution}" />
                            <ItemsControl Tag="stressres" ItemsSource="{Binding Resolutions}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr stress.msaa}" />
                            <ItemsControl Tag="stressmsaa" ItemsSource="{Binding MsaaOptions}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr stress.intensity}" />
                            <ItemsControl Tag="stressint" ItemsSource="{Binding Intensities}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr stress.limit}" />
                            <ItemsControl Tag="stresslimit" ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr gpu.duration}" />
                            <ItemsControl Tag="stressdur" ItemsSource="{Binding Durations}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        </StackPanel>

                        <Grid Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="220">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE945;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr stress.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.elapsed}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="FPS" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding FpsText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr stress.maxTemp}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent1}" Text="{Binding MaxTempText}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0" Text="{Binding SummaryText}"
                                   Visibility="{Binding SummaryText, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ leituras ao vivo -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr gpu.live}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.temp}" />
                <TextBlock Style="{StaticResource BigNumber}" FontSize="48" Text="{Binding Live.Temperature}" />
                <UniformGrid Columns="2" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.load}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Load}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.clock}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Clock}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.power}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Power}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr stress.perfcap}" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="14" TextWrapping="Wrap" Text="{Binding Live.Limiter}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
