<UserControl x:Class="SupernovaBench.App.Views.GpuBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,14">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr gpu.title}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr gpu.subtitle}" />
        </StackPanel>

        <!-- ============================================================ coluna principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- placa e configuração -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradient}">
                                <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="20"
                                           Foreground="{DynamicResource OnAccent}" Text="&#xE7F4;" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr gpu.adapter}" />
                                <TextBlock Style="{StaticResource H2}" Text="{Binding AdapterName}" />
                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding AdapterDetail}"
                                           Visibility="{Binding AdapterDetail, Converter={StaticResource EmptyToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" Text="{loc:Tr gpu.resolution}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Resolutions}" IsEnabled="{Binding IsIdle}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Option}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="gpures" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="{loc:Tr gpu.duration}" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Durations}" IsEnabled="{Binding IsIdle}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Option}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="gpudur" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" Text="{loc:Tr gpu.window}" />

                        <Grid Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="220">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE768;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- progresso -->
                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <ProgressBar Margin="0,10,0,12" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.elapsed}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.fpsNow}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding FpsNowText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.avgFps}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding AvgFpsText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.low1}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Low1Text}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- pontuação -->
                <Border Style="{StaticResource Hero}" Margin="0,12,0,0" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="16" Text="{loc:Tr cpu.score}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BigNumber}" FontSize="60" Text="{Binding ScoreText}" />
                            <TextBlock Margin="10,0,0,10" VerticalAlignment="Bottom" FontSize="22" Style="{StaticResource TextMuted}" Text="{loc:Tr cpu.points}" />
                        </StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Good}" Text="{loc:Tr cpu.newBest}"
                                   Visibility="{Binding IsNewBest, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ painel lateral -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr gpu.live}" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.temp}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent3}" Text="{Binding Live.Temperature}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.load}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Load}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.clock}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Clock}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.power}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Live.Power}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr cpu.ranking}" />
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" Text="{loc:Tr gpu.ranking.empty}"
                                   Visibility="{Binding Ranking.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Ranking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RankingRow}">
                                    <Border x:Name="Row" Margin="0,6,0,0" Padding="10,8" CornerRadius="10" Background="Transparent">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontWeight="Bold" Text="{Binding ScoreText}" />
                                                <TextBlock Style="{StaticResource TextMuted}" Width="24" Text="{Binding Position}" />
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Margin="24,0,0,0" FontSize="11" Style="{StaticResource TextMuted}" Text="{Binding Detail}" />
                                            <ProgressBar Margin="24,6,0,0" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
