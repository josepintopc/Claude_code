<UserControl x:Class="SupernovaBench.App.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />
    </UserControl.Resources>

    <DockPanel Margin="4,0,8,8">
        <!-- cabeçalho -->
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Muted}" Text="{Binding CountText}" />
                <Grid Width="280">
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Muted}"
                               Text="{loc:Tr sensors.search}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding Filter, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                </Grid>
                <Button Margin="8,0,0,0" Command="{Binding Sensors.ResetMinMaxCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Tr sensors.resetMinMax}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="{loc:Tr sensors.title}" />
                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr sensors.subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- problema com sensores da CPU -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12"
                Visibility="{Binding Sensors.HasCpuProblem, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                    <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="{loc:Tr ov.sensorWarning}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding Sensors.ProblemText}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding Sensors.CanInstallPawnIO, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding Sensors.InstallPawnIOCommand}"
                            Content="{loc:Tr sensors.installPawnio}" />
                    <Button Margin="8,0,0,0" Command="{Binding Sensors.OpenPawnIOSiteCommand}" Content="{loc:Tr sensors.pawnioSite}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Text="{Binding Sensors.InstallStatus}"
                           Visibility="{Binding Sensors.InstallStatus, Converter={StaticResource EmptyToVis}}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{Binding Sensors.StatusText}"
                   Visibility="{Binding Sensors.StatusText, Converter={StaticResource EmptyToVis}}" />

        <Border Style="{StaticResource Card}" Padding="8">
            <DataGrid ItemsSource="{Binding View}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Margin="10,14,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Accent1}"
                                           Text="{Binding Name}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="2*" Binding="{Binding Name}">
                        <DataGridTextColumn.Header><TextBlock Text="{loc:Tr sensors.col.sensor}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Category}">
                        <DataGridTextColumn.Header><TextBlock Text="{loc:Tr sensors.col.type}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold">
                        <DataGridTextColumn.Header><TextBlock Text="{loc:Tr sensors.col.value}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Min}" FontFamily="{StaticResource MonoFont}">
                        <DataGridTextColumn.Header><TextBlock Text="{loc:Tr sensors.col.min}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Max}" FontFamily="{StaticResource MonoFont}">
                        <DataGridTextColumn.Header><TextBlock Text="{loc:Tr sensors.col.max}" /></DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
