<UserControl x:Class="SupernovaBench.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,8,8">
            <!-- ======================================================== cabeçalho -->
            <DockPanel Margin="0,4,0,12">
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                    <Button Margin="0,0,8,0" Style="{StaticResource GhostButton}" Command="{Binding BackupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8C8;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.backup}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0" Style="{StaticResource GhostButton}" Command="{Binding CreateRestorePointCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE777;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.restore.create}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpdatesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE895;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.check}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{loc:Tr drivers.title}" />
                    <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{loc:Tr drivers.subtitle}" />
                </StackPanel>
            </DockPanel>

            <!-- status -->
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12"
                    Visibility="{Binding StatusText, Converter={StaticResource EmptyToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{loc:Tr common.cancel}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding StatusText}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7E8;" />
                    <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" Text="{loc:Tr drivers.reboot}" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource TextMuted}" Margin="0,0,0,12" Text="{loc:Tr common.loading}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- ======================================================== placa de vídeo -->
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <DockPanel>
                        <ItemsControl DockPanel.Dock="Right" Tag="nvbranch" ItemsSource="{Binding Branches}" ItemTemplate="{StaticResource ChipTemplate}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}" IsEnabled="{Binding IsIdle}" />
                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{loc:Tr drivers.gpu.title}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" Text="{loc:Tr drivers.gpu.none}"
                               Visibility="{Binding Gpus.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GpuDriverCard}">
                                <Border Margin="0,12,0,0" Padding="16" CornerRadius="12" Background="{DynamicResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="8" Background="{DynamicResource Good}"
                                                    Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" Text="{loc:Tr drivers.badge.upToDate}" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="8" Background="{DynamicResource AccentGradientHorizontal}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccent}" Text="{loc:Tr drivers.badge.update}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding InstalledText}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding LatestText}"
                                                   Visibility="{Binding LatestText, Converter={StaticResource EmptyToVis}}" />
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                                                   Text="{loc:Tr drivers.gpu.otherHint}"
                                                   Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}" />

                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                            <ProgressBar Maximum="100" Value="{Binding DownloadProgress, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource Mono}" FontSize="12" Margin="0,4,0,0" Text="{Binding DownloadText}" />
                                        </StackPanel>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" CommandParameter="{Binding}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.InstallNvidiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE896;" />
                                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.nvidia.install}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="0,0,8,0" Content="{loc:Tr drivers.nvidia.notes}" CommandParameter="{Binding}"
                                                    Visibility="{Binding Latest, Converter={StaticResource EmptyToVis}}"
                                                    Command="{Binding DataContext.OpenReleaseNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Button Content="{Binding VendorButtonText}" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenVendorPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======================================================== Windows Update -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding InstallWindowsUpdatesCommand}"
                                Visibility="{Binding WuUpdates.Count, Converter={StaticResource EmptyToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE896;" />
                                <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.wu.install}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{loc:Tr drivers.wu.title}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{loc:Tr drivers.wu.hint}"
                               Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding WuStatus}"
                               Visibility="{Binding WuStatus, Converter={StaticResource EmptyToVis}}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding WuUpdates}" IsEnabled="{Binding IsIdle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WuItem}">
                                <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="10" Background="{DynamicResource Card}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding IsSelected}" />
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======================================================== problemas e restauração -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{loc:Tr drivers.deviceManager}"
                                    Command="{Binding OpenDeviceManagerCommand}" />
                            <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{loc:Tr drivers.problems}" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding NoProblems, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Good}" Text="&#xE73E;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr drivers.problems.none}" />
                        </StackPanel>
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProblemItem}">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="Icon" DockPanel.Dock="Left" Style="{StaticResource Glyph}" FontSize="13" Margin="0,2,8,0"
                                                   Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Text="{Binding Detail}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDisconnected}" Value="True">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Muted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{loc:Tr drivers.restore.open}"
                                    Command="{Binding OpenSystemRestoreCommand}" />
                            <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center" Text="{loc:Tr drivers.restore.title}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{loc:Tr drivers.restore.none}"
                                   Visibility="{Binding NoRestorePoints, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RestorePointRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RestorePointRow}">
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="12" Margin="12,0,0,0" Text="{Binding Date}" />
                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Description}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Text="{loc:Tr drivers.restore.hint}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== todos os drivers -->
            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="260">
                            <TextBox Padding="32,6,10,6" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Glyph}" FontSize="13"
                                       Foreground="{DynamicResource Muted}" Text="&#xE721;" />
                        </Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{loc:Tr drivers.all}" />
                            <TextBlock Style="{StaticResource TextMuted}" Text="{Binding CountText}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl Margin="0,12,0,8" Tag="drivercat" ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource ChipTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}" />
                    <DataGrid Height="420" IsReadOnly="True" ItemsSource="{Binding Drivers}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Name}">
                                <DataGridTextColumn.Header><TextBlock Text="{loc:Tr drivers.col.device}" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Category}">
                                <DataGridTextColumn.Header><TextBlock Text="{loc:Tr drivers.col.category}" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Provider}">
                                <DataGridTextColumn.Header><TextBlock Text="{loc:Tr drivers.col.provider}" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding Version}" FontFamily="{StaticResource MonoFont}">
                                <DataGridTextColumn.Header><TextBlock Text="{loc:Tr drivers.col.version}" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Width="100" Binding="{Binding Date}" FontFamily="{StaticResource MonoFont}">
                                <DataGridTextColumn.Header><TextBlock Text="{loc:Tr drivers.col.date}" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Width="80" Binding="{Binding IsSigned, Mode=OneWay}" IsReadOnly="True">
                                <DataGridCheckBoxColumn.Header><TextBlock Text="{loc:Tr drivers.col.signed}" /></DataGridCheckBoxColumn.Header>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
