<UserControl x:Class="SupernovaBench.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,8,8" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Margin="0,4,0,14">
                <TextBlock Style="{StaticResource H1}" Text="{loc:Tr set.title}" />
                <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr set.subtitle}" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr set.language}" />
                    <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Option}">
                                <RadioButton Style="{StaticResource Chip}" GroupName="language" Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr set.theme}" />
                    <ItemsControl Margin="0,8,0,8" ItemsSource="{Binding Themes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Option}">
                                <RadioButton Style="{StaticResource Chip}" GroupName="theme" Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr set.sensorInterval}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Intervals}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Option}">
                                <RadioButton Style="{StaticResource Chip}" GroupName="interval" Content="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr set.dataFolder}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Command="{Binding OpenDataFolderCommand}" Content="{loc:Tr set.openFolder}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Mono}" Text="{Binding DataFolder}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Hero}" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource LogoImage}" Width="40" Height="40" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="18">
                                <Run Text="Supernova" FontWeight="Bold" /><Run Text=" Bench" FontWeight="Light" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource TextMuted}" Text="{Binding VersionText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="{loc:Tr set.credits}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{loc:Tr set.credits.text}" />
                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding OpenRepositoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE774;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr set.sourceCode}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
