<UserControl x:Class="SupernovaBench.App.Views.GameMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:s="clr-namespace:SupernovaBench.App.Services"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,12">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr monitor.title}" />
            <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{loc:Tr monitor.subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Banner}" Margin="0,0,0,12"
                Visibility="{Binding Overlay.ErrorText, Converter={StaticResource EmptyToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Text="{Binding Overlay.ErrorText}" />
            </StackPanel>
        </Border>

        <!-- ============================================================ ao vivo -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Hero}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MinWidth="170">
                            <TextBlock Style="{StaticResource TextMuted}" Text="{Binding Overlay.AppName}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource BigNumber}" FontSize="64" Text="{Binding Overlay.FpsText}" />
                                <TextBlock Margin="8,0,0,14" VerticalAlignment="Bottom" FontSize="20" Style="{StaticResource TextMuted}" Text="FPS" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding Overlay.FrameTimeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,4,0,0">
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr monitor.bottleneck}" />
                            <TextBlock FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Accent1}" Text="{Binding Overlay.BottleneckText}" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Overlay.BottleneckAdvice}" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource Mono}" FontSize="13" Text="{Binding Overlay.CpuText}" />
                            <TextBlock Style="{StaticResource Mono}" FontSize="13" Text="{Binding Overlay.GpuText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- gravação -->
                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Tr monitor.record.title}" />
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Tr monitor.record.hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartRecordingCommand}"
                                    Visibility="{Binding Overlay.IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE7C8;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr monitor.record.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopRecordingCommand}" Padding="20,10"
                                    Visibility="{Binding Overlay.IsRecording, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr monitor.record.stop}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding Overlay.HasSummary, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Overlay.SummaryTitle}" />
                            <TextBlock Style="{StaticResource Mono}" Margin="0,4,0,0" Text="{Binding Overlay.SummaryText}" />
                            <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent1}" Text="{Binding Overlay.SummaryVerdict}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Overlay.SummaryAdvice}" />
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Overlay.SummaryShares}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type s:ShareRow}">
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Label}" />
                                            <ProgressBar Grid.Column="1" Height="8" Maximum="100" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Mono}" Text="{Binding PercentText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Text="{loc:Tr monitor.limits}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ overlay -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardPanel}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="{loc:Tr monitor.overlay}" />
                <CheckBox Margin="0,12,0,0" Foreground="{DynamicResource Fg}" FontWeight="SemiBold" IsChecked="{Binding Overlay.OverlayEnabled}"
                          Content="{loc:Tr monitor.overlay.enable}" />
                <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="22,4,0,0" TextWrapping="Wrap" Text="{loc:Tr monitor.overlay.hotkey}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,8" Text="{loc:Tr monitor.overlay.corner}" />
                <ItemsControl Tag="ovcorner" ItemsSource="{Binding Corners}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr monitor.overlay.opacity}" />
                <ItemsControl Tag="ovopacity" ItemsSource="{Binding Opacities}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />
                <CheckBox Margin="0,10,0,0" Foreground="{DynamicResource Fg}" IsChecked="{Binding Overlay.ShowSensors}" Content="{loc:Tr monitor.overlay.sensors}" />
                <CheckBox Margin="0,6,0,0" Foreground="{DynamicResource Fg}" IsChecked="{Binding Overlay.ShowBottleneck}" Content="{loc:Tr monitor.overlay.bottleneck}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
