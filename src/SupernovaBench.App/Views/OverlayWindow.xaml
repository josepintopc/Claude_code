<Window x:Class="SupernovaBench.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SupernovaBench.App.Controls"
        Title="Supernova Bench Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Opacity="{Binding OverlayOpacity}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <!-- Cores fixas (não seguem o tema): o overlay precisa ser legível por cima de qualquer jogo. -->
        <SolidColorBrush x:Key="OverlayBg" Color="#E00B0A14" />
        <SolidColorBrush x:Key="OverlayText" Color="#FFF2EEFF" />
        <SolidColorBrush x:Key="OverlayMuted" Color="#FFB4ADD3" />
        <LinearGradientBrush x:Key="OverlayAccent" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF7A2F" Offset="0" />
            <GradientStop Color="#FFE0379B" Offset="0.55" />
            <GradientStop Color="#FF7B3FF2" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Border Margin="12" Padding="12,8,14,10" CornerRadius="10" Background="{StaticResource OverlayBg}"
            BorderBrush="{StaticResource OverlayAccent}" BorderThickness="0,0,0,2" MinWidth="150">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="26" FontWeight="Bold" Foreground="#FFFF9A4D" Text="{Binding FpsText}" />
                <TextBlock Margin="6,0,0,4" VerticalAlignment="Bottom" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource OverlayMuted}" Text="FPS" />
                <TextBlock Margin="10,0,0,4" VerticalAlignment="Bottom" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           Foreground="{StaticResource OverlayMuted}" Text="{Binding FrameTimeText}" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="{StaticResource OverlayMuted}" TextTrimming="CharacterEllipsis" MaxWidth="260" Text="{Binding AppName}" />
            <StackPanel Margin="0,4,0,0" Visibility="{Binding ShowSensors, Converter={StaticResource BoolToVis}}">
                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource OverlayText}" Text="{Binding CpuText}" />
                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource OverlayText}" Text="{Binding GpuText}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFC94D" Text="{Binding BottleneckText}"
                       Visibility="{Binding ShowBottleneck, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Border>
</Window>
