<UserControl x:Class="SupernovaBench.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls"
             xmlns:info="clr-namespace:SupernovaBench.Core.Info;assembly=SupernovaBench.Core">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <c:InfoNodeTemplateSelector x:Key="NodeSelector" />

        <!-- Linha rótulo / valor -->
        <DataTemplate x:Key="InfoFieldTemplate" DataType="{x:Type info:InfoNode}">
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,16,0" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Body}" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <!-- Grupo: cartão com título e filhos (que podem ser grupos de novo) -->
        <DataTemplate x:Key="InfoGroupTemplate" DataType="{x:Type info:InfoNode}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}">
                        <Run Text="{Binding Label, Mode=OneWay}" />
                        <Run Text="{Binding Value, Mode=OneWay}" Foreground="{DynamicResource Muted}" FontWeight="Normal" />
                    </TextBlock>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Children}" ItemTemplateSelector="{StaticResource NodeSelector}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="4,0,8,8">
        <!-- cabeçalho -->
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource Good}" Text="{loc:Tr hw.copied}"
                           Visibility="{Binding ShowCopied, Converter={StaticResource BoolToVis}}" />
                <Button Command="{Binding CopyCommand}" ToolTip="{loc:Tr hw.copyTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8C8;" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Tr hw.copy}" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                        <TextBlock Margin="8,0,0,0" Text="{loc:Tr hw.refresh}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="{loc:Tr hw.title}" />
                <TextBlock Style="{StaticResource Muted}" Text="{loc:Tr hw.subtitle}" />
            </StackPanel>
        </DockPanel>

        <!-- seções -->
        <ListBox DockPanel.Dock="Top" Style="{StaticResource ChipList}" ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type info:InfoSection}">
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8" Text="{loc:Tr hw.loading}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SelectedSection.Nodes}" ItemTemplateSelector="{StaticResource NodeSelector}" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
