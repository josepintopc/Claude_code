<UserControl x:Class="SupernovaBench.App.Views.CpuStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,12">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr cpustress.title}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr cpustress.subtitle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                    <TextBlock Margin="10,0,0,0" Style="{StaticResource Body}" TextWrapping="Wrap" Text="{loc:Tr cpustress.warning}" />
                </StackPanel>
            </Border>
            <!-- sem temperatura da CPU: oferece o PawnIO, como na página Sensores -->
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12"
                    Visibility="{Binding Sensors.HasCpuProblem, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Text="{Binding Sensors.ProblemText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding Sensors.CanInstallPawnIO, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding Sensors.InstallPawnIOCommand}"
                                Content="{loc:Tr sensors.installPawnio}" />
                        <Button Margin="8,0,0,0" Command="{Binding Sensors.OpenPawnIOSiteCommand}" Content="{loc:Tr sensors.pawnioSite}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" Text="{Binding Sensors.InstallStatus}"
                               Visibility="{Binding Sensors.InstallStatus, Converter={StaticResource EmptyToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============================================================ configuração e estado -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr cpustress.cpu}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Text="{Binding CpuName}" />

                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,8" Text="{loc:Tr cpustress.mode}" />
                            <ItemsControl Tag="cpustressmode" ItemsSource="{Binding Modes}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding ModeDescription}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr cpustress.threads}" />
                            <ItemsControl Tag="cpustressthreads" ItemsSource="{Binding ThreadOptions}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr stress.limit}" />
                            <ItemsControl Tag="cpustresslimit" ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr gpu.duration}" />
                            <ItemsControl Tag="cpustressdur" ItemsSource="{Binding Durations}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <CheckBox Margin="0,10,0,0" Foreground="{DynamicResource Fg}" IsChecked="{Binding StopOnError}"
                                      Content="{loc:Tr cpustress.stopOnError}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="220">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE945;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr stress.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.elapsed}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr stress.maxTemp}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent1}" Text="{Binding MaxTempText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpustress.blocks}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding IterationsText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpustress.errors}" />
                                <TextBlock x:Name="ErrorsValue" Text="{Binding ErrorsText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                            <Setter Property="Foreground" Value="{DynamicResource Good}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding SummaryText}"
                                   Visibility="{Binding SummaryText, Converter={StaticResource EmptyToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ leituras ao vivo -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardPanel}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr gpu.live}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource StatLabel}" Text="{loc:Tr ov.cpuTemp}" />
                <TextBlock Style="{StaticResource BigNumber}" FontSize="48" Text="{Binding Sensors.CpuTempText}" />
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.load}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Sensors.CpuLoadText}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.clock}" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding Sensors.CpuClockText}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr gpu.power}" />
                        <TextBlock Style="{StaticResource StatValue}" Text="{Binding Sensors.CpuPowerText}" />
                    </StackPanel>
                </UniformGrid>
                <c:LineChart Height="160" Margin="0,16,0,0"
                             Series="{Binding Sensors.TemperatureSeries}"
                             Revision="{Binding Sensors.Revision}"
                             GridBrush="{DynamicResource Line}"
                             LabelBrush="{DynamicResource Muted}" />
                <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" Text="{loc:Tr ov.chartLegend}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
