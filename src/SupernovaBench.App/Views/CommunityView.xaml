<UserControl x:Class="SupernovaBench.App.Views.CommunityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <DockPanel Margin="4,0,8,8">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,4,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr health.refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE898;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr community.submit}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{loc:Tr community.title}" />
                    <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{loc:Tr community.subtitle}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Banner}" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}" />
            </Border>

            <ItemsControl Margin="0,0,0,8" Tag="communitytest" ItemsSource="{Binding Tests}" ItemTemplate="{StaticResource ChipTemplate}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
            <TextBlock Style="{StaticResource H2}" Margin="0,4,0,8" Text="{Binding MyPositionText}"
                       Visibility="{Binding MyPositionText, Converter={StaticResource EmptyToVis}}" />
            <TextBlock Style="{StaticResource TextMuted}" TextWrapping="Wrap" Text="{loc:Tr community.empty}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="{loc:Tr community.footer}" />

        <Border Style="{StaticResource CardPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CommunityRowView}">
                            <Border x:Name="Row" Margin="0,4,0,0" Padding="10,8" CornerRadius="10" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center" Text="{Binding Position, StringFormat={}{0}º}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Device}" />
                                        <TextBlock Style="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"
                                                   Visibility="{Binding Detail, Converter={StaticResource EmptyToVis}}" />
                                        <ProgressBar Margin="0,6,0,0" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Mono}"
                                               FontWeight="Bold" Text="{Binding ScoreText}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMine}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
