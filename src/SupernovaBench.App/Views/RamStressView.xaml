<UserControl x:Class="SupernovaBench.App.Views.RamStressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,12">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr ramstress.title}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr ramstress.subtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Banner}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Warn}" Text="&#xE7BA;" />
                <TextBlock Margin="10,0,0,0" Style="{StaticResource Body}" TextWrapping="Wrap" Text="{loc:Tr ramstress.warning}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr ov.ram}" />
                        <TextBlock Style="{StaticResource H2}" Margin="0,4,0,0" Text="{Binding MemoryText}" />

                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,8" Text="{loc:Tr ramstress.amount}" />
                            <ItemsControl Tag="ramamount" ItemsSource="{Binding Amounts}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,8" Text="{loc:Tr gpu.duration}" />
                            <ItemsControl Tag="ramdur" ItemsSource="{Binding Durations}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="220">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE945;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr stress.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0" Padding="20,14">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Good}" />
                                            <Setter Property="FontSize" Value="18" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                            <Setter Property="FontSize" Value="18" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Margin="0,10,0,12" Maximum="100" Value="{Binding Coverage, Mode=OneWay}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ramstress.coverage}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent1}" Text="{Binding CoverageText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ramstress.passes}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding PassesText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.elapsed}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ramstress.tested}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding TestedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ramstress.speed}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding SpeedText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ramstress.pattern}" />
                                <TextBlock Style="{StaticResource StatValue}" FontSize="14" Text="{Binding PatternText}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- erros -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardPanel}" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorsText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                <Setter Property="Foreground" Value="{DynamicResource Good}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Bad}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr ramstress.errors}" />
                </DockPanel>
                <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{loc:Tr ramstress.noErrors}"
                           Visibility="{Binding ErrorLines.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ErrorLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Mono}" FontSize="11" Margin="0,2" TextWrapping="Wrap" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Text="{loc:Tr ramstress.footer}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
