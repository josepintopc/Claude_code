<UserControl x:Class="SupernovaBench.App.Views.MemoryBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,14">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr mem.title}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr mem.subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- máquina e botão -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentGradient}">
                                <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="20"
                                           Foreground="{DynamicResource OnAccent}" Text="&#xE964;" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H2}" Text="{Binding RamName}" />
                                <TextBlock Style="{StaticResource TextMuted}" Text="{Binding CpuName}" />
                                <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Text="{Binding CacheText}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" Text="{loc:Tr mem.hint}" />

                        <Grid Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="220">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE768;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.start}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- tabela estilo AIDA64 -->
                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" Text="{Binding ElapsedText}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ProgressBar Margin="0,10,0,14" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <UniformGrid Grid.Column="1" Columns="4">
                                <TextBlock Style="{StaticResource HeadCell}" Text="{Binding MemoryHeader}" />
                                <TextBlock Style="{StaticResource HeadCell}" Text="L1" />
                                <TextBlock Style="{StaticResource HeadCell}" Text="L2" />
                                <TextBlock Style="{StaticResource HeadCell}" Text="L3" />
                            </UniformGrid>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MemRow}">
                                    <Border Margin="0,0,0,6" Padding="0,8" CornerRadius="10" Background="{DynamicResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:MemCell}">
                                                        <Border x:Name="CellBorder" Margin="4,0" Padding="0,4,10,4" CornerRadius="8" Background="Transparent">
                                                            <Grid>
                                                                <TextBlock Style="{StaticResource Mono}" FontSize="15" HorizontalAlignment="Right" Text="{Binding Text}" />
                                                                <TextBlock x:Name="Dots" Style="{StaticResource TextMuted}" HorizontalAlignment="Right" Text="•••"
                                                                           Visibility="Collapsed" />
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                                <Setter TargetName="Dots" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{loc:Tr mem.units}" />
                    </StackPanel>
                </Border>

                <!-- pontuação -->
                <Border Style="{StaticResource Hero}" Margin="0,12,0,0" Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="16" Text="{loc:Tr cpu.score}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource BigNumber}" FontSize="60" Text="{Binding ScoreText}" />
                            <TextBlock Margin="10,0,0,10" VerticalAlignment="Bottom" FontSize="22" Style="{StaticResource TextMuted}" Text="{loc:Tr cpu.points}" />
                        </StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Good}" Text="{loc:Tr cpu.newBest}"
                                   Visibility="{Binding IsNewBest, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{loc:Tr mem.scoreHint}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ranking -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="{loc:Tr cpu.ranking}" />
                    <TextBlock Style="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{loc:Tr ranking.empty}"
                               Visibility="{Binding Ranking.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Ranking}" ItemTemplate="{StaticResource RankingRowTemplate}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
