<UserControl x:Class="SupernovaBench.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:Option}">
            <RadioButton Style="{StaticResource Chip}" GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- capa com cantos arredondados: gradiente + iniciais, a imagem por cima quando existe, ou o ícone do .exe -->
        <DataTemplate x:Key="CoverTemplate" DataType="{x:Type vm:GameCard}">
            <Border CornerRadius="12" Background="{DynamicResource HeroGradient}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                    <Viewbox x:Name="InitialsBox" Margin="24" MaxHeight="64">
                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource Fg}" Opacity="0.85" Text="{Binding Initials}" />
                    </Viewbox>
                    <Border x:Name="CoverFill" CornerRadius="11" Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Image x:Name="IconImage" Width="72" Height="72" Source="{Binding Cover}" Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasCover}" Value="True">
                    <Setter TargetName="InitialsBox" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CoverFill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CoverIsIcon}" Value="True">
                    <Setter TargetName="CoverFill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="IconImage" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- cartão da grade -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:GameCard}">
            <Grid x:Name="CardRoot" Width="150" Margin="0,0,16,18" Background="Transparent" Cursor="Hand"
                  ToolTip="{Binding Name}">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <MouseBinding Gesture="LeftClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid.InputBindings>
                <StackPanel>
                    <Grid Width="150" Height="225">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CoverTemplate}" Focusable="False" />
                        <!-- loja -->
                        <Border Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="7,2" CornerRadius="8"
                                Background="{DynamicResource Overlay}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White" Text="{Binding StoreName}" />
                        </Border>
                        <!-- favorito / jogando -->
                        <StackPanel Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <Border Padding="6,2" CornerRadius="8" Background="{DynamicResource Good}"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" Text="{loc:Tr games.playing}" />
                            </Border>
                            <TextBlock Margin="6,0,0,0" Style="{StaticResource Glyph}" FontSize="14" Foreground="#FFFFC94D" Text="&#xE735;"
                                       Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <!-- botão jogar no hover -->
                        <Button x:Name="HoverPlay" Style="{StaticResource PrimaryButton}" Margin="10" Padding="14,6"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource OnAccent}" Text="&#xE768;" />
                                <TextBlock Margin="6,0,0,0" Text="{loc:Tr games.play}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Margin="2,8,2,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Margin="2,1,2,0" Style="{StaticResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding PlaytimeText}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverPlay" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="4,0,8,8">
        <!-- ============================================================ cabeçalho -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,4,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE72C;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr health.refresh}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding AddGameCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE710;" />
                            <TextBlock Margin="8,0,0,0" Text="{loc:Tr games.add}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="{loc:Tr games.title}" />
                    <TextBlock Style="{StaticResource TextMuted}">
                        <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{loc:Tr games.subtitle}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="{Binding HasNowPlaying, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Good}" Text="&#xE7FC;" />
                    <TextBlock Margin="10,0,0,0" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding NowPlayingText}" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,0,0,8">
                <ItemsControl DockPanel.Dock="Right" Tag="gamesort" ItemsSource="{Binding Sorts}" ItemTemplate="{StaticResource ChipTemplate}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}" />
                <Grid MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,12,0">
                    <TextBox Padding="32,8,10,8" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{DynamicResource Muted}" Text="&#xE721;" />
                    <TextBlock Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Style="{StaticResource TextMuted}"
                               Text="{loc:Tr games.search}"
                               Visibility="{Binding Search, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>

            <DockPanel Margin="0,0,0,10">
                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" IsChecked="{Binding ShowHidden}"
                          Content="{loc:Tr games.showHidden}" />
                <ItemsControl Tag="gamestore" ItemsSource="{Binding StoreFilters}" ItemTemplate="{StaticResource ChipTemplate}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}" />
            </DockPanel>

            <TextBlock Style="{StaticResource TextMuted}" Margin="0,0,0,8" Text="{loc:Tr games.scanning}"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding MissingStoresText}"
                       Visibility="{Binding MissingStoresText, Converter={StaticResource EmptyToVis}}" />
        </StackPanel>

        <!-- ============================================================ detalhes -->
        <Border DockPanel.Dock="Right" Width="360" Margin="12,0,0,0" Style="{StaticResource CardPanel}" Padding="0"
                Visibility="{Binding Details, Converter={StaticResource EmptyToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" DataContext="{Binding Details}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TitleBarButton}" Width="34" Height="34" Content="&#xE8BB;"
                                ToolTip="{loc:Tr title.close}"
                                Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Card.StoreName}" />
                    </DockPanel>
                    <ContentControl Width="180" Height="270" Margin="0,8,0,0" HorizontalAlignment="Left" Focusable="False"
                                    Content="{Binding Card}" ContentTemplate="{StaticResource CoverTemplate}" />
                    <TextBlock Style="{StaticResource H2}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Card.Name}" />

                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" CommandParameter="{Binding Card}"
                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE768;" />
                                <TextBlock Margin="8,0,0,0" Text="{loc:Tr games.play}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Content="{loc:Tr games.openFolder}" CommandParameter="{Binding Card}"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button Margin="0,0,8,8" CommandParameter="{Binding Card}" ToolTip="{loc:Tr games.favorite}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE734;" />
                        </Button>
                        <Button Margin="0,0,8,8" CommandParameter="{Binding Card}" ToolTip="{loc:Tr games.hide}"
                                Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xED1A;" />
                        </Button>
                        <Button Margin="0,0,8,8" Content="{loc:Tr games.remove}" CommandParameter="{Binding Card}"
                                Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.playtime}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Card.PlaytimeText}" />
                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.lastPlayed}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Card.LastPlayedText}" />
                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.sessions}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding SessionsText}" />
                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.size}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding SizeText}" />
                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.folder}" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Text="{Binding InstallDir}" />
                    <TextBlock Style="{StaticResource InfoLabel}" Text="{loc:Tr games.exe}" />
                    <TextBlock Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Text="{Binding ExeText}" />

                    <!-- perfil de desempenho -->
                    <Border Margin="0,18,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{loc:Tr games.profile}" />
                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Tr games.profile.hint}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,6" Text="{loc:Tr games.power}" />
                            <ItemsControl Tag="gamepower" ItemsSource="{Binding PowerPlans}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,6" Text="{loc:Tr games.priority}" />
                            <ItemsControl Tag="gameprio" ItemsSource="{Binding Priorities}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,6" Text="{loc:Tr games.gpu}" />
                            <ItemsControl Tag="gamegpu" ItemsSource="{Binding Gpus}" ItemTemplate="{StaticResource ChipTemplate}"
                                          ItemsPanel="{StaticResource WrapPanelTemplate}" IsEnabled="{Binding GpuEnabled}" />
                            <TextBlock Style="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Text="{loc:Tr games.gpu.unknown}"
                                       Visibility="{Binding GpuEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================================================ grade de capas (virtualizada por linhas) -->
        <Grid SizeChanged="Grid_SizeChanged">
            <StackPanel VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Tr games.empty}" />
                <TextBlock Style="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{loc:Tr games.empty.hint}" />
            </StackPanel>
            <TextBlock VerticalAlignment="Top" Style="{StaticResource TextMuted}" Text="{loc:Tr games.noResults}"
                       Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameRow}">
                        <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>
