<UserControl x:Class="SupernovaBench.App.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,0,8,8">
            <Border Style="{StaticResource Hero}" Padding="32,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource AccentGradient}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Glyph}" HorizontalAlignment="Center" FontSize="30"
                                   Foreground="{DynamicResource OnAccent}" Text="{Binding Glyph}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Card}">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent1}" Text="{loc:Tr soon.badge}" />
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Card}" Margin="8,0,0,0">
                                <TextBlock FontSize="12" Foreground="{DynamicResource Muted}" Text="{Binding PhaseText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource H1}" Margin="0,10,0,0" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" FontSize="15" Text="{Binding Description}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource H2}" Margin="4,22,0,10" Text="{loc:Tr soon.roadmap}" />
            <ItemsControl ItemsSource="{Binding Roadmap}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RoadmapEntry}">
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,10,10" Padding="16,14">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent1}" FontSize="18" Text="{Binding Glyph}" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextMuted}" VerticalAlignment="Center" Text="{Binding PhaseText}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
