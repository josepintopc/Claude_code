<UserControl x:Class="SupernovaBench.App.Views.CpuBenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupernovaBench.App.Localization"
             xmlns:vm="clr-namespace:SupernovaBench.App.ViewModels"
             xmlns:c="clr-namespace:SupernovaBench.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- cabeçalho -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,4,0,14">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Tr cpu.title}" />
            <TextBlock Style="{StaticResource TextMuted}" Text="{loc:Tr cpu.subtitle}" />
        </StackPanel>

        <!-- ============================================================ imagem -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardPanel}" Padding="10" Background="{DynamicResource Panel}">
                <Viewbox Stretch="Uniform">
                    <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                        <Image Source="{Binding Bitmap}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- blocos sendo renderizados agora (um por thread) -->
                        <ItemsControl ItemsSource="{Binding Markers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BucketMarker}">
                                    <Border Width="{Binding W}" Height="{Binding H}" BorderThickness="2" CornerRadius="2"
                                            BorderBrush="{DynamicResource Accent1}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- resultado por cima da imagem -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24" Padding="22,14" CornerRadius="16"
                                Background="{DynamicResource Overlay}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock FontSize="22" Style="{StaticResource TextMuted}" Text="{loc:Tr cpu.score}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource BigNumber}" FontSize="72" Text="{Binding ScoreText}" />
                                    <TextBlock Margin="12,0,0,12" VerticalAlignment="Bottom" FontSize="26" Style="{StaticResource TextMuted}"
                                               Text="{loc:Tr cpu.points}" />
                                </StackPanel>
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Good}" Text="{loc:Tr cpu.newBest}"
                                           Visibility="{Binding IsNewBest, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
            </Border>

            <!-- progresso -->
            <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,12,0,0" Padding="20,14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextMuted}" Text="{Binding ResolutionText}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                    </DockPanel>
                    <ProgressBar Margin="0,10,0,12" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                    <UniformGrid Columns="4">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.elapsed}" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ElapsedText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.rate}" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding RateText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.threads}" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ThreadsText}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr cpu.passes}" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding PassesText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ painel lateral -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- modo e controles -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr cpu.mode}" />
                        <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding IsIdle}">
                            <RadioButton Style="{StaticResource Chip}" GroupName="cpumode" Content="{loc:Tr cpu.mode.multi}"
                                         IsChecked="{Binding IsMulti, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="cpumode" Content="{loc:Tr cpu.mode.single}"
                                         IsChecked="{Binding IsSingle, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="cpumode" Content="{loc:Tr cpu.mode.sustained}"
                                         IsChecked="{Binding IsSustained, Mode=TwoWay}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,4,0,0" Text="{Binding ModeDescription}" />
                        <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding CpuName}" />

                        <Grid Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource OnAccent}" Text="&#xE768;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.start}" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Command="{Binding StopCommand}" Padding="20,10"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Bad}" Text="&#xE71A;" />
                                    <TextBlock Margin="8,0,0,0" Text="{loc:Tr cpu.stop}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0" Text="{loc:Tr cpu.tip}" />
                    </StackPanel>
                </Border>

                <!-- sensores durante o teste -->
                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr cpu.live}" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ov.cpuTemp}" />
                                <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource Accent1}" Text="{Binding Sensors.CpuTempText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ov.cpuLoad}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Sensors.CpuLoadText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ov.cpuClock}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Sensors.CpuClockText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource StatLabel}" Text="{loc:Tr ov.cpuPower}" />
                                <TextBlock Style="{StaticResource StatValue}" Text="{Binding Sensors.CpuPowerText}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ranking -->
                <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr cpu.ranking}" />
                        <TextBlock Style="{StaticResource TextMuted}" Margin="0,8,0,0" Text="{loc:Tr cpu.ranking.empty}"
                                   Visibility="{Binding Ranking.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Ranking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RankingRow}">
                                    <Border x:Name="Row" Margin="0,6,0,0" Padding="10,8" CornerRadius="10" Background="Transparent">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontWeight="Bold" Text="{Binding ScoreText}" />
                                                <TextBlock Style="{StaticResource TextMuted}" Width="24" Text="{Binding Position}" />
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Margin="24,0,0,0" FontSize="11" Style="{StaticResource TextMuted}" Text="{Binding Detail}" />
                                            <ProgressBar Margin="24,6,0,0" Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
