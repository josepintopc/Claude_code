<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema "Light" do Supernova Bench: só cores. Os estilos (Controls.xaml) usam DynamicResource, então trocar este
         dicionário em tempo de execução muda a aparência do app inteiro. -->
    <Color x:Key="BgColor">#F6F4FB</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#F3F0FA</Color>
    <Color x:Key="CardHoverColor">#E9E4F6</Color>
    <Color x:Key="LineColor">#E2DCF0</Color>
    <Color x:Key="FgColor">#1A1530</Color>
    <Color x:Key="MutedColor">#6B6488</Color>
    <Color x:Key="Accent1Color">#F2661A</Color>
    <Color x:Key="Accent2Color">#D02C8C</Color>
    <Color x:Key="Accent3Color">#6A30E0</Color>
    <Color x:Key="AccentSoftColor">#EFE6FF</Color>
    <Color x:Key="GoodColor">#16A36B</Color>
    <Color x:Key="WarnColor">#B97F00</Color>
    <Color x:Key="BadColor">#D93554</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="OverlayColor">#CCF6F4FB</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Fg" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Accent1" Color="{StaticResource Accent1Color}" />
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="Accent3" Color="{StaticResource Accent3Color}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="Good" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Bad" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Accent1Color}" />
        <GradientStop Offset="0.5" Color="{StaticResource Accent2Color}" />
        <GradientStop Offset="1" Color="{StaticResource Accent3Color}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="{StaticResource Accent1Color}" />
        <GradientStop Offset="0.5" Color="{StaticResource Accent2Color}" />
        <GradientStop Offset="1" Color="{StaticResource Accent3Color}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1" Opacity="0.22">
        <GradientStop Offset="0" Color="{StaticResource Accent1Color}" />
        <GradientStop Offset="0.55" Color="{StaticResource Accent2Color}" />
        <GradientStop Offset="1" Color="{StaticResource Accent3Color}" />
    </LinearGradientBrush>
</ResourceDictionary>
